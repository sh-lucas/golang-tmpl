# Directory containing sqlite.db and large_blobs/. A relative path is resolved from the process working directory.
DATABASE_ROOT=data

# TCP port exposed by the HTTP server.
SERVER_PORT=3000

# Required HMAC secret for admin session tokens. Use a long random value.
JWT_SECRET=replace-with-a-long-random-secret

# Required Bearer token for the /libsql/ endpoint.
DATABASE_ACCESS_KEY=replace-with-a-long-random-access-key

# Required for /libsql route. Allows remote control over database.
DATABASE_ACCESS_KEY=12345678
